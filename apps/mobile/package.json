{
  "name": "@gymverse/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc -p .",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "build:cloudflare": "expo export --platform web --clear && node ../../scripts/cf-headers.mjs dist",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@gymverse/shared": "0.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.8",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/test/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 75,
        "branches": 70
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/afterEnv.ts"
    ],
    "testTimeout": 20000
  }
}
