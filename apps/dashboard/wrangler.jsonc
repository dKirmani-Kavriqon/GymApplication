// Owner dashboard on Cloudflare (Workers static assets; no server code).
// Build first: VITE_API_URL=https://api.example.com npm run build:cloudflare
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gymverse-dashboard",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  // "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
  "env": {
    "staging": { "name": "gymverse-dashboard-staging" }
  }
}
