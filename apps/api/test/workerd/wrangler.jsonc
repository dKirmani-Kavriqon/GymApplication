// Test-only Worker: runs the database driver checks inside workerd (npm run test:worker).
{
  "name": "gymverse-driver-conformance",
  "main": "conformance-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "CONFORMANCE", "class_name": "Conformance" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conformance"] }]
}
