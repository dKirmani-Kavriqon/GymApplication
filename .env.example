# SELF-HOSTING ONLY (deploy/docker-compose.yml). Production on Cloudflare uses wrangler vars and
# secrets instead: see docs/PRODUCTION.md. Copy to .env and fill in. Never commit .env.
# The API refuses to start in production if a required value is missing or unsafe.

# --- Hostnames (Caddy gets TLS certificates for these automatically) ---
API_HOST=api.example.com
DASHBOARD_HOST=app.example.com
ACME_EMAIL=ops@example.com

# --- API ---
NODE_ENV=production
# Public https URL of the API (used for the hosted payment page links).
PUBLIC_API_URL=https://api.example.com
LOG_LEVEL=info
# 32+ random characters: openssl rand -base64 48
TOKEN_SECRET=
# Comma-separated browser origins allowed to call the API (the dashboard).
CORS_ORIGINS=https://app.example.com
# Phone numbers (E.164) that can use the platform admin console.
PLATFORM_ADMIN_PHONES=+919999900001

# --- SMS for login codes: log | msg91 | twilio ---
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Payments: mock | razorpay ---
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Push notifications (Expo push service; optional access token for enhanced security) ---
EXPO_ACCESS_TOKEN=

# --- Backups (Litestream → S3 / R2 / B2) ---
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
